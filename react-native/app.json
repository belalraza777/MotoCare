{
  "expo": {
    "name": "MotoCare",
    "slug": "motocare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/motocarelogo.png",
    "scheme": "motocare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/motocarelogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/motocarelogo.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/motocarelogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/motocarelogo.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}